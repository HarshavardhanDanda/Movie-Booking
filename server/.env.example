# Copy these settings into your local .env. Never commit real secrets.
DATABASE=mongodb://127.0.0.1:27017/movie-booking?replicaSet=rs0
PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Start with Razorpay TEST keys and enable automatic capture in its dashboard.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Same Web client ID used by the frontend. No Google client secret is needed.
GOOGLE_CLIENT_ID=
